# Two hostnames, and the split between them is deliberate.
#
#   tire.zedth.my.id        the application: static SPA, with /api/* reverse
#                           proxied to the api container on the SAME ORIGIN
#   tire-store.zedth.my.id  nothing but the signed upload/download endpoint
#
# WHY SAME-ORIGIN FOR THE API IS AN IMPROVEMENT
# PLAN/01 §4.2 accepted CORS, cross-origin cookie handling, and a second deploy
# entry as the price of splitting the SPA from the API. Proxying /api through
# the same hostname removes all three: there is no CORS preflight, the session
# cookie is host-only, and there is one public entry point. What PLAN/01 wanted
# from the split — a client/server boundary that cannot leak, and a backend not
# tied to React — is a property of the code, not of the hostname, and it is kept.
#
# WHY THE STORAGE HOST IS SEPARATE
# It serves customer fleet photographs, authorised solely by a signed, expiring,
# single-purpose token (PLAN/05 §7). Putting it on its own hostname means the
# session cookie is never sent there at all — the cookie is host-only on
# tire.zedth.my.id — so a leaked storage URL carries no session with it.
# Everything except the upload route answers 404 there.
#
# BEHIND CLOUDFLARE TUNNEL
# cloudflared terminates TLS at the Cloudflare edge and connects to this Caddy
# over plain HTTP, so ACME is switched off and both sites listen on :80. Caddy
# still does the routing, the headers, and the SPA fallback.

{
	# Cloudflare issues and terminates the certificates; Caddy must not try.
	auto_https off
	servers {
		# cloudflared is the only client, and it is on the container network.
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}
}

# ── The application ─────────────────────────────────────────────────────────
http://tire.zedth.my.id {
	import security_headers

	header {
		# No 'unsafe-inline' anywhere (PLAN/13 §7, decision A-07). The dashboard
		# chart is hand-written SVG rather than a charting library precisely so
		# this can stay strict.
		#
		# `connect-src 'self'` now covers the API, because it is same-origin.
		# tire-store is listed for the photo PUT and for image loads.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://tire-store.zedth.my.id data: blob:; connect-src 'self' https://tire-store.zedth.my.id; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# The API, same origin. No CORS, no preflight, no cross-site cookie rules.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/web

		# A stale service worker serves an old app to a new API (PLAN/06 §5.1).
		@sw path /sw.js
		header @sw Cache-Control "no-cache, must-revalidate"

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}

# ── The storage host ────────────────────────────────────────────────────────
http://tire-store.zedth.my.id {
	import security_headers

	# It returns images and nothing else. No scripts, no framing, no referrer.
	header {
		Content-Security-Policy "default-src 'none'; img-src 'self'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Cross-Origin-Resource-Policy "cross-origin"
	}

	# The ONLY route reachable here. Authorisation is the signed token in the
	# path; see apps/api/src/modules/uploads/routes.ts.
	handle /api/uploads/* {
		reverse_proxy api:3000
	}

	# Anything else is not merely forbidden, it does not exist. An attacker who
	# finds this hostname learns nothing about what else the API can do.
	handle {
		respond 404
	}
}
