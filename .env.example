# Copy to .env and fill in. .env is never committed and is never written by the
# agent (PLAN/09 §4.5, PLAN/13 §8).

NODE_ENV=development
APP_ENV=local                      # local | staging | production
APP_VERSION=0.1.0

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000
# Exact allowlist; never '*' and never a reflected Origin header (PLAN/13 §2).
# production: https://tire.zedth.my.id
WEB_ORIGIN=http://localhost:5173
# production: zedth.my.id — the shared registrable domain is what keeps the
# session cookie on SameSite=Strict across tire. and tire-api.
COOKIE_DOMAIN=localhost
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://c26:change-me@localhost:5432/c26?schema=public

# ── File storage ────────────────────────────────────────────────────────────
# `local` writes to UPLOAD_DIR on disk and serves uploads through the API with
# short-lived signed tokens. `s3` talks to Cloudflare R2 (PLAN/01 §4.2) and is
# the production target once volumes justify it; the client protocol is
# identical either way, so switching is a driver change and nothing else.
STORAGE_DRIVER=local

# local driver
UPLOAD_DIR=./uploads
# Public base URL of the API, used to build upload and download links.
PUBLIC_API_URL=http://localhost:3000
# Signs upload/download tokens. 32+ random characters.
STORAGE_SIGNING_KEY=change-me-long-random-string

# s3 driver (ignored while STORAGE_DRIVER=local)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32-byte key, base64. Encrypts TOTP secrets (PLAN/13 §3.2). Rotating it
# invalidates every enrolled authenticator, so treat it as permanent.
MFA_ENCRYPTION_KEY=change-me-32-bytes-base64

# ── Email (PLAN/12 §4) ──────────────────────────────────────────────────────
EMAIL_PROVIDER=console             # console | resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@zedth.my.id

# ── Observability (PLAN/01 §6) ──────────────────────────────────────────────
SENTRY_DSN=

# ── Seed (local and staging only; refused when APP_ENV=production) ──────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-at-least-10-chars
