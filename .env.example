# Copy to .env and fill in. .env is never committed and is never written by the
# agent (PLAN/09 §4.5, PLAN/13 §8).

NODE_ENV=development
APP_ENV=local                      # local | staging | production
APP_VERSION=0.1.0

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000
# Exact allowlist; never '*' and never a reflected Origin header (PLAN/13 §2).
#
# In production this is nearly vestigial: Caddy proxies /api on the same origin
# as the SPA, so browsers send no cross-origin request and no preflight. It is
# kept for local development, where Vite runs on :5173 and the API on :3000.
# production: https://tire.zedth.my.id
WEB_ORIGIN=http://localhost:5173

# Leave EMPTY for a host-only cookie, which is what production should use.
#
# A host-only cookie on tire.zedth.my.id is never sent to tire-store.zedth.my.id,
# so a leaked photo URL carries no session with it. Setting this to `zedth.my.id`
# would widen the cookie to every subdomain and give that property away.
# production: (empty)
COOKIE_DOMAIN=localhost
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace | silent

# Hostname that serves signed photo URLs and NOTHING else. Every other path on
# it answers 404 — see apps/api/src/kernel/http/hosts.ts, which is tested.
# Leave empty locally, where everything is localhost and there is nothing to
# split.
# production: tire-store.zedth.my.id
STORAGE_HOST=

# Built SPA served by this process. Empty locally: Vite serves the client on
# :5173 and proxies /api here, so nothing should serve it twice.
# production: ./web
WEB_DIST_DIR=

# ── Database ────────────────────────────────────────────────────────────────
# The password here MUST match POSTGRES_PASSWORD in docker-compose.yml. The value
# below is the local development one and is already in that file in plain text —
# it is a throwaway credential for a container that publishes only to localhost.
# Change both together for staging and production.
DATABASE_URL=postgresql://c26:c26_local_only@localhost:5432/c26?schema=public

# ── File storage ────────────────────────────────────────────────────────────
# `local` writes to UPLOAD_DIR on disk and serves uploads through the API with
# short-lived signed tokens. `s3` talks to Cloudflare R2 (PLAN/01 §4.2) and is
# the production target once volumes justify it; the client protocol is
# identical either way, so switching is a driver change and nothing else.
STORAGE_DRIVER=local

# local driver.
# Relative paths resolve against the working directory of whichever process
# reads them, and both the API and the seed run from apps/api — so `./uploads`
# means apps/api/uploads locally, and /app/uploads in the container.
UPLOAD_DIR=./uploads

# Base URL that upload and download links are built from — the storage host,
# NOT the application host. Photos are the only thing served there, and the
# signed token in the path is the only authorisation (PLAN/05 §7).
# production: https://tire-store.zedth.my.id
PUBLIC_API_URL=http://localhost:3000
# Signs upload/download tokens. 32+ random characters.
STORAGE_SIGNING_KEY=change-me-long-random-string

# s3 driver (ignored while STORAGE_DRIVER=local)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32-byte key, base64. Encrypts TOTP secrets (PLAN/13 §3.2). Rotating it
# invalidates every enrolled authenticator, so treat it as permanent.
MFA_ENCRYPTION_KEY=change-me-32-bytes-base64

# ── Email (PLAN/12 §4) ──────────────────────────────────────────────────────
EMAIL_PROVIDER=console             # console | resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@zedth.my.id

# ── Observability (PLAN/01 §6) ──────────────────────────────────────────────
SENTRY_DSN=

# ── Seed (local and staging only; refused when APP_ENV=production) ──────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-at-least-10-chars

# Password shared by the demo accounts (supplier1, supplier2, admin1, manager1,
# operator1) and their sample inspections. Leave it empty to seed master data
# and the first admin only.
#
# These are demo ACCOUNTS, not a demo LOGIN PATH: each one has a real Argon2id
# hash and signs in through the same route as anybody else. The legacy system's
# three no-credential buttons (D-16) do not exist here, and gate G-10 checks
# that they never come back.
SEED_DEMO_PASSWORD=change-me-at-least-10-chars

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# cloudflared runs on the VM, not in a container, so it needs no variable here.
# Point BOTH hostnames at the same origin, http://127.0.0.1:3000:
#   tire.zedth.my.id        the application
#   tire-store.zedth.my.id  signed photo URLs only
# The api tells them apart by Host header.
